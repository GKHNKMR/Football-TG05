# Vercel serves this repo as a plain static site (see vercel.json).
# Nothing below is needed at runtime — it exists for the daily GitHub Actions
# build — so keep it out of the deployment.

scripts/
.github/

# Historical datasets used only by the build scripts, not by the pages.
data/football-data/
data/cache/

# Build-only intermediates. Pages fetch data/results.json (the graded output),
# not these.
data/predictions-archive.json

# Backtest CSV is not fetched by any page.
data/backtest-pl-2526.csv
